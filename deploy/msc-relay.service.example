# systemd --user unit template for the Mobile Session Control relay.
#
# Copy to ~/.config/systemd/user/msc-relay.service and replace:
#   @NODE@       absolute node executable (command -v node)
#   @REPO@       absolute repository path
#   @CONFIG@     absolute private service config path (mode 0600)
#   @STATE_DIR@  writable private directory for state, key, pairing and logs
#   @PROJECT_ROOT@  an exact native session cwd native tools may edit; repeat
#                   the placeholder for each root
#
# Phase 9 rejects a real-mode baseDir under ~/.local, ~/.config, ~/.cache,
# ~/.ssh or ~/.claude. For real mode use a separate writable root (for example
# $HOME/msc-service) and list every writable root in ReadWritePaths, separated
# by spaces.
#
# With the optional native section, the relay also needs write access to the
# real Claude session store for resumed transcripts. Keep ProtectHome=read-only
# and add the session store plus exact session cwds:
#   ReadWritePaths=@STATE_DIR@ %h/.claude @PROJECT_ROOT@
# Repeat @PROJECT_ROOT@ for each root. Do not use the whole project tree or a
# user home: list only the cwds of sessions that need file edits. A cwd outside
# the list still chats; its file edits fail closed.
# Native workers run with a private temporary HOME and
# CLAUDE_CONFIG_DIR=%h/.claude. The observed .claude.json is written inside
# that config dir, not the HOME root; the temporary HOME isolates other HOME
# writes. The write set is still to be measured in a real sandbox (P2b) before
# enabling native mode in production.
#
# ProtectSystem=strict makes paths outside ReadWritePaths read-only. A reviewed
# unit change with the exact roots is required before claiming real native
# takeover. WSL drvfs roots need a real namespace test first.
#
# Native workers take ANTHROPIC_* from the service environment. Put those
# values in a mode-0600 EnvironmentFile= referenced by the unit, not a shell
# profile and not this config file.
#
# This unit binds the loopback relay only. Remote access must terminate at a
# private-network proxy such as `tailscale serve`; do not expose the relay
# directly. See docs/SERVICE.md before installing.
[Unit]
Description=Mobile Session Control loopback relay
After=network.target
OnFailure=msc-relay-alert.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=@NODE@ @REPO@/packages/cli/src/service.mjs
Environment=MSC_SERVICE_CONFIG=@CONFIG@
Restart=on-failure
RestartSec=2
TimeoutStopSec=30
KillMode=mixed
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@STATE_DIR@
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=default.target
