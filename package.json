{
  "name": "mobile-session-control",
  "version": "0.1.4",
  "private": true,
  "description": "Private, self-hosted phone control for local Claude Code-compatible sessions across DeepSeek, Kimi and GLM",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/L-X-Yao/mobile-session-control.git"
  },
  "keywords": [
    "claude-code",
    "self-hosted",
    "pwa",
    "mobile",
    "deepseek",
    "kimi",
    "glm"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node scripts/verify.mjs",
    "verify": "node scripts/verify.mjs",
    "precommit": "node scripts/precommit.mjs",
    "review:packet": "node scripts/review-packet.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "test:cli": "node --test --test-concurrency=1 packages/cli/test/*.test.mjs",
    "test:coverage": "node --test --test-concurrency=1 --test-timeout=120000 --experimental-test-coverage --test-coverage-lines=85 packages/cli/test/*.test.mjs",
    "scenario": "node scripts/scenario.mjs",
    "bench": "node scripts/bench.mjs",
    "e2e:web": "node scripts/e2e-web.mjs",
    "release:artifacts": "node scripts/release-artifacts.mjs",
    "test:soak": "node scripts/soak.mjs",
    "backup:state": "node scripts/backup-state.mjs",
    "revoke:device": "node scripts/revoke-device.mjs",
    "restore:drill": "node scripts/restore-drill.mjs",
    "validate:profiles": "node packages/cli/src/providers/validate-cli.mjs examples/providers",
    "demo:m1": "node packages/cli/src/demos/m1-demo.mjs",
    "demo:web": "node packages/cli/src/demos/m1-web-demo.mjs",
    "demo:real": "node packages/cli/src/demos/phase9-web-demo.mjs"
  }
}
